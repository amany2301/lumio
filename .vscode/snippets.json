{
  "Lumio Initialize": {
    "prefix": "lumio-init",
    "body": [
      "import 'package:lumio/lumio.dart';",
      "",
      "void main() async {",
      "  WidgetsFlutterBinding.ensureInitialized();",
      "  ",
      "  // Initialize Lumio monitoring",
      "  await Lumio.initialize(",
      "    enableCrashMonitoring: true,",
      "    enableAnrMonitoring: true,",
      "    enableDebugOverlay: true,",
      "  );",
      "  ",
      "  runApp(MyApp());",
      "}"
    ],
    "description": "Initialize Lumio in main.dart"
  },
  "Lumio HTTP Client": {
    "prefix": "lumio-http",
    "body": [
      "final LumioHttpClient _httpClient = LumioHttpClient();",
      "",
      "@override",
      "void dispose() {",
      "  _httpClient.close();",
      "  super.dispose();",
      "}",
      "",
      "Future<void> _makeRequest() async {",
      "  try {",
      "    // This will be automatically logged by Lumio",
      "    final response = await _httpClient.get('https://api.example.com/data');",
      "    // Process response...",
      "  } catch (e) {",
      "    print('Error: \$e');",
      "  }",
      "}"
    ],
    "description": "Add Lumio HTTP client with automatic logging"
  },
  "Lumio Debug Overlay": {
    "prefix": "lumio-overlay",
    "body": [
      "LumioApp(",
      "  enableDebugOverlay: true,",
      "  child: MaterialApp(",
      "    title: 'My App',",
      "    home: MyHomePage(),",
      "  ),",
      ")"
    ],
    "description": "Wrap app with Lumio debug overlay"
  },
  "Lumio Debug Button": {
    "prefix": "lumio-button",
    "body": [
      "IconButton(",
      "  icon: Icon(Icons.bug_report),",
      "  onPressed: () => Lumio.toggleDebugOverlay(),",
      "  tooltip: 'Toggle Debug Overlay',",
      ")"
    ],
    "description": "Add debug overlay toggle button"
  },
  "Lumio Manual Logging": {
    "prefix": "lumio-log",
    "body": [
      "// Log network calls manually",
      "await Lumio.logNetworkCall('GET', 'https://api.example.com/users', 250);",
      "",
      "// Log API responses manually",
      "await Lumio.logApiResponse(",
      "  'https://api.example.com/users',",
      "  200,",
      "  '{\"users\": []}',",
      ");",
      "",
      "// Log crashes manually",
      "await Lumio.logCrash(",
      "  'Exception message',",
      "  'Stack trace...',",
      ");"
    ],
    "description": "Manual logging examples"
  },
  "Lumio Status Check": {
    "prefix": "lumio-status",
    "body": [
      "print('Initialized: \${Lumio.isInitialized}');",
      "print('Crash monitoring: \${Lumio.isCrashMonitoringEnabled}');",
      "print('ANR monitoring: \${Lumio.isAnrMonitoringEnabled}');",
      "print('Debug overlay: \${Lumio.isDebugOverlayEnabled}');"
    ],
    "description": "Check Lumio status"
  },
  "Lumio Import": {
    "prefix": "lumio-import",
    "body": [
      "import 'package:lumio/lumio.dart';"
    ],
    "description": "Import Lumio package"
  }
}
